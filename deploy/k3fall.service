[Unit]
Description=k3fall K3 IF waterfall server
After=network.target sdrplay.service
Wants=sdrplay.service

[Service]
ExecStart=/usr/local/bin/k3fall /etc/k3fall/config.toml
Restart=on-failure
RestartSec=3
User=k3fall
SupplementaryGroups=dialout plugdev
StateDirectory=k3fall

[Install]
WantedBy=multi-user.target
